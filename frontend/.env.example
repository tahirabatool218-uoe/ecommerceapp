# Public frontend configuration only.
# Never put secrets (database URIs, JWT secrets, etc.) in this file.
# Every VITE_* variable is bundled into the browser build and visible to anyone.

# Base URL of the backend API (must include the /api prefix)
VITE_API_BASE_URL=http://localhost:5000/api

# Optional display settings
VITE_APP_NAME=Shopfront
VITE_CURRENCY=PKR
